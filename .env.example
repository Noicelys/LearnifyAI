# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง (อย่า commit .env ขึ้น git)
#   cp .env.example .env

# พอร์ตที่เปิดออกนอกเครื่อง (ตอน dev เข้าที่ http://localhost:3000)
APP_PORT=3000

# ตัววิเคราะห์: cloud = Typhoon Cloud (ต้องมีคีย์ด้านล่าง) · ollama = รันบนการ์ดจอในเครื่อง
AI_PROVIDER=cloud

# Typhoon API — สมัครฟรีที่ https://opentyphoon.ai
TYPHOON_API_KEY=
TYPHOON_BASE_URL=https://api.opentyphoon.ai/v1
TYPHOON_MODEL=typhoon-v2.5-30b-a3b-instruct
TYPHOON_TIMEOUT_MS=60000

# ความลับสำหรับ session cookie ของครู — สุ่มเอง เช่น: openssl rand -hex 32
SESSION_SECRET=

# รหัสผ่านเข้าหน้าครู — ตั้งเองก่อนใช้จริง
TEACHER_PASSWORD=
# ตั้ง true เมื่อ deploy หลัง HTTPS แล้ว (ตอน dev บน http ต้องเป็น false)
COOKIE_SECURE=false

# ใช้เฉพาะตอนครูวางลิงก์ "โฟลเดอร์" Drive — สมัครที่ Google Cloud Console
GOOGLE_API_KEY=

# ── ตัวถอดเสียง ────────────────────────────────────────────
# local = รันในเครื่อง (ต้องสตาร์ตด้วย --profile local-stt) · cloud = ยิงไป API ข้างนอก
STT_PROVIDER=cloud
# คีย์ของเจ้าที่ใช้ — Groq สมัครฟรีที่ https://console.groq.com/keys
STT_API_KEY=
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3
STT_TIMEOUT_MS=120000
# เพดานขนาดไฟล์ที่ผู้ให้บริการรับ (Groq/OpenAI = 25MB) เผื่อไว้นิดหน่อยกัน 413
STT_MAX_UPLOAD_MB=24

# ── ค่าด้านล่างใช้เฉพาะโหมด STT_PROVIDER=local ─────────────
# โมเดล Whisper: tiny | base | small | medium | large-v3-turbo
# ภาษาไทยถอดยาก (ไม่เว้นวรรคระหว่างคำ + วรรณยุกต์) — small เพี้ยนจนอ่านไม่รู้เรื่องบ่อย
# large-v3-turbo แม่นใกล้เคียง large-v3 แต่เร็วกว่ามาก ใช้ RAM ~2.2GB จึงต้องตั้ง limit 4g
# ถ้าเครื่องช้าเกินไป ถอยมาเป็น medium (ยังดีกว่า small ชัดเจน)
ASR_MODEL=large-v3-turbo
WHISPER_MEMORY_LIMIT=4g

# ใช้เฉพาะตอนเปิด profile proxy (Caddy + HTTPS)
DOMAIN=localhost

# ── PostgreSQL ─────────────────────────────────────────────
POSTGRES_PORT=5433
POSTGRES_DB=Education_AI
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# ── Google OAuth 2.0 ───────────────────────────────────────
# สร้าง OAuth client (ประเภท Web application) ที่ Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OpenCodeZen (DeepSeek) ─────────────────────────────────
OPENCODEZEN_API_KEY=
OPENCODEZEN_BASE_URL=https://opencode.ai/zen/v1
OPENCODEZEN_MODEL=deepseek-v4-flash-free
